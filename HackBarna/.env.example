# Never expose these values to Vite/client code.
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
# Optional cached ~180-day bearer token used by the disposable bake script.
DEEPFIRE_TMP_TOKEN=
DEEPFIRE_API_URL=https://api.deepfire.co

DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai
DEVIN_ORG_ID=
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU=2

# Server-only Vonage Video API application credentials. Download the generated RSA private key
# from the Vonage dashboard into .secrets/vonage-private.key; never put its contents in this file.
# The browser receives only short-lived session tokens.
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=.secrets/vonage-private.key

# Server-only SLNG voice credentials. Model defaults are suitable starting points; select valid catalog models/voice IDs for your account.
SLNG_API_KEY=
SLNG_STT_MODEL=slng/deepgram/nova:3-en
SLNG_TTS_MODEL=slng/deepgram/aura:2-en
SLNG_TTS_VOICE=aura-2-thalia-en

# OpenAI-compatible conversational model used by Ari. The backend appends /chat/completions.
LIAISON_LLM_BASE_URL=https://api.openai.com/v1
LIAISON_LLM_API_KEY=
LIAISON_LLM_MODEL=gpt-4.1-mini

RUST_LOG=fastandslow_backend=info,tower_http=info
